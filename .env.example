# Auth.js (D-0156 / D-0161 / D-0163 / D-0177)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — primary public sign-in when set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Operator account (Credentials provider) — not a full user database.
# Production / Vercel: set these explicitly (required for email/password admin login).
# Local: if unset and NODE_ENV=development, documented defaults apply —
# see docs/ADMIN_PLATFORM.md (D-0177). Prefer explicit values in `.env.local`.
# Never commit real prod passwords.
#
# Local / example pattern (also written to gitignored `.env.local` for npm run dev):
# AUTH_DEMO_EMAIL=admin@savencore.com
# AUTH_DEMO_PASSWORD=SavenCore-Dev-Admin!
# AUTH_DEMO_ROLE=super_admin
#
# The demo operator always receives role `super_admin` (AUTH_DEMO_ROLE is documented
# for clarity; code maps the demo identity to super_admin).
AUTH_DEMO_EMAIL=
AUTH_DEMO_PASSWORD=
AUTH_DEMO_ROLE=super_admin

# Admin RBAC allowlist for Google (or other) signed-in emails (D-0176).
# Comma-separated email:role — roles: super_admin|admin|editor|marketer|viewer
# AUTH_ADMIN_ALLOWLIST=you@example.com:super_admin

# Public site origin — set on Vercel Production (and Preview if testing OAuth)
# AUTH_URL=https://www.savencore.com
# Optional alias some Auth.js setups still read:
# NEXTAUTH_URL=https://www.savencore.com

# Canonical public URL for sitemap, robots, Open Graph (D-0162)
# NEXT_PUBLIC_SITE_URL=https://www.savencore.com

# Optional public social profile URLs (D-0176). Leave empty until real.
# Icons stay visible but disabled when unset — do not invent fake profiles.
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_SOCIAL_X=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# Optional SMTP for admin mailings (D-0178). When unset, Send is simulated
# (In Development) and an outbox copy is stored — never claimed as real delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=info@savencore.com
# SMTP_SECURE=false
