# Auth.js (D-0156 / D-0161 / D-0163)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — primary public sign-in when set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional staging/launch-test operator account (Credentials provider).
# Not a full user database. Do not commit real passwords.
# Leave empty in production unless you intentionally need operator testing.
# AUTH_DEMO_EMAIL=operator@example.com
# AUTH_DEMO_PASSWORD=
# AUTH_DEMO_ROLE=super_admin

# Admin RBAC allowlist for Google (or other) signed-in emails (D-0176).
# Comma-separated email:role — roles: super_admin|admin|editor|marketer|viewer
# AUTH_ADMIN_ALLOWLIST=you@example.com:super_admin

# Public site origin — set on Vercel Production (and Preview if testing OAuth)
# AUTH_URL=https://www.savencore.com
# Optional alias some Auth.js setups still read:
# NEXTAUTH_URL=https://www.savencore.com

# Canonical public URL for sitemap, robots, Open Graph (D-0162)
# NEXT_PUBLIC_SITE_URL=https://www.savencore.com

# Optional public social profile URLs (D-0176). Leave empty until real.
# Icons stay visible but disabled when unset — do not invent fake profiles.
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_SOCIAL_X=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
