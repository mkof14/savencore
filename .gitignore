# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# editor-local
.idea/
.vscode/
*.swp
*.swo
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example tracked)
.env
.env.*
!.env.example
.env*.local

# typescript
*.tsbuildinfo

# vercel
.vercel

# local verification artifacts
/tmp/

# admin media uploads (keep directory markers)
/storage/admin-media/files/*
!/storage/admin-media/files/.gitkeep
/storage/admin-media/index.json

# admin platform JSON runtime store (D-0178) — seed defaults live in code
/storage/admin/*
!/storage/admin/.gitkeep
